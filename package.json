{
  "name": "verse-cloud",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build-school-poems": "node scripts/build-school-poems.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "verify:corpus": "vite-node scripts/verify-school-corpus.ts",
    "audit:user-journey": "playwright test tests/e2e/user-journey-audit.spec.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@chinese-fonts/zqfs": "^3.0.0",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
